[Unit]
Description=Центр управления умными переходами (админка, YOLO)
After=network-online.target smartcross-emulator.service
Wants=network-online.target

[Service]
WorkingDirectory=/opt/smartcross/center
Environment=PYTHONIOENCODING=utf-8 PYTHONUNBUFFERED=1 YOLO_CONFIG_DIR=/opt/smartcross/center/.ultralytics
ExecStart=/opt/smartcross/center/.venv/bin/python -m center --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
