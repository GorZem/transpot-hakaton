[Unit]
Description=Эмулятор участка Люблино (камеры и светофоры)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/smartcross/emulator
Environment=PYTHONIOENCODING=utf-8 PYTHONUNBUFFERED=1 EMULATOR_HEADLESS=1
ExecStart=/opt/smartcross/emulator/.venv/bin/python -m emulator --host 127.0.0.1 --port 8100
Restart=always
RestartSec=3
Nice=-5

[Install]
WantedBy=multi-user.target
