[Unit]
Description=SmartCross — умный пешеходный переход
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smartcross
WorkingDirectory=/opt/smartcross
Environment=SMARTCROSS_ADMIN_PASSWORD=change-me
ExecStart=/opt/smartcross/.venv/bin/python -m smartcross --config /opt/smartcross/config/local.yaml --port 8000
Restart=always
RestartSec=3
Nice=-5

[Install]
WantedBy=multi-user.target
